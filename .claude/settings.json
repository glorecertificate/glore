{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["cloudflare", "neon"],
  "permissions": {
    "allow": [
      "Bash(pnpm run check)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run typegen)",
      "Bash(pnpm run db:up)",
      "Bash(pnpm run db:seed)",
      "Bash(pnpm exec oxfmt:*)",
      "Bash(pnpm exec oxlint:*)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm exec next typegen)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.vercel/**)",
      "Edit(./types/*.generated.d.ts)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.ts|\"$CLAUDE_PROJECT_DIR\"/*.tsx|\"$CLAUDE_PROJECT_DIR\"/*.mts|\"$CLAUDE_PROJECT_DIR\"/*.json|\"$CLAUDE_PROJECT_DIR\"/*.css|\"$CLAUDE_PROJECT_DIR\"/*.md|\"$CLAUDE_PROJECT_DIR\"/*.yml) cd \"$CLAUDE_PROJECT_DIR\" && pnpm exec oxfmt \"$f\" >/dev/null 2>&1 ;; esac; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
