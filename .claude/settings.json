{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["cloudflare", "neon"],
  "permissions": {
    "allow": [
      "Bash(agent-browser --version)",
      "Bash(agent-browser auth list)",
      "Bash(agent-browser console *)",
      "Bash(agent-browser console)",
      "Bash(agent-browser errors)",
      "Bash(agent-browser get *)",
      "Bash(agent-browser session list)",
      "Bash(agent-browser skills get *)",
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser snapshot)",
      "Bash(gh run watch *)",
      "Bash(node_modules/.bin/tsc --noEmit *)",
      "Bash(node_modules/.bin/tsc --noEmit)",
      "Bash(npm view *)",
      "Bash(pnpm config get *)",
      "Bash(pnpm exec next typegen)",
      "Bash(pnpm exec oxfmt:*)",
      "Bash(pnpm exec oxlint:*)",
      "Bash(pnpm exec tsc --noEmit *)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run check)",
      "Bash(pnpm run db:seed)",
      "Bash(pnpm run db:up)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run test)",
      "Bash(pnpm run typegen)",
      "Bash(rex capture *)",
      "Bash(rex capture)",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__context7__query-docs",
      "mcp__context7__resolve-library-id",
      "mcp__neon__list_branches"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.vercel/**)",
      "Edit(./types/*.generated.d.ts)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*.ts|\"$CLAUDE_PROJECT_DIR\"/*.tsx|\"$CLAUDE_PROJECT_DIR\"/*.mts|\"$CLAUDE_PROJECT_DIR\"/*.json|\"$CLAUDE_PROJECT_DIR\"/*.css|\"$CLAUDE_PROJECT_DIR\"/*.md|\"$CLAUDE_PROJECT_DIR\"/*.yml) cd \"$CLAUDE_PROJECT_DIR\" && pnpm exec oxfmt \"$f\" >/dev/null 2>&1 ;; esac; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
