{
  "name": "glore",
  "version": "0.6.14",
  "homepage": "https://glorecertificate.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glorecertificate/glore.git"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mts",
    "typegen": "node scripts/typegen.mts",
    "dev": "NODE_OPTIONS=\"--import ./scripts/dev-preload.mts --max-old-space-size=4096\" portless glore --app-port 45673 next dev",
    "dev:clean": "rm -rf .next && pnpm run dev",
    "build": "next build",
    "start": "portless run next start",
    "check": "pnpm run --parallel \"/^check:/\"",
    "check:types": "tsc --noEmit",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:knip": "knip",
    "check:i18n": "node scripts/i18n/check.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.local -e .env -- playwright test",
    "deploy:preview": "dotenv -- sh -c 'vercel build && vercel --prebuilt'",
    "deploy:production": "dotenv -- sh -c 'vercel build && vercel --prebuilt --prod'",
    "db": "dotenv -e .env.local -e .env -- drizzle-kit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:seed": "dotenv -e .env.local -e .env -- node scripts/seed.mts",
    "db:seed:demo": "dotenv -e .env.local -e .env -- node scripts/seed-demo.mts",
    "content:check": "node scripts/content/check.mts",
    "content:import": "dotenv -e .env.local -e .env -- node scripts/content/import.mts",
    "mail:up": "docker compose up -d mailpit",
    "email": "portless email.glore dotenv -- email dev --dir src/emails --port 45674",
    "release": "dotenv -- release-it --config release.config.ts",
    "analyze": "next experimental-analyze",
    "bump": "corepack use pnpm@latest && pnpm update -Li",
    "skills": "skills experimental_install --yes"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.83",
    "@ai-sdk/provider": "3.0.10",
    "@ai-sdk/provider-utils": "4.0.30",
