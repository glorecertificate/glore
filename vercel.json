{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run typegen && pnpm run build",
  "regions": ["fra1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/v1/cron/daily",
      "schedule": "0 3 * * *"
    }
  ]
}
